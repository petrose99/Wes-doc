{$DOCUBITE_DOMAIN} {
	# Hold and retry requests while the web container restarts (deploys, crashes) instead of
	# failing them: visitors mid-deploy see a slower load, never an error page. 60s comfortably
	# covers a container recreate + prisma migrate deploy + next start (~10-30s in practice).
	reverse_proxy web:7331 {
		lb_try_duration 60s
		lb_try_interval 2s
	}
}

# www is a redirect, not a second origin — keeps one canonical host so
# auth cookies and Supabase redirect URLs only ever see the apex domain.
{$DOCUBITE_WWW_DOMAIN} {
	redir https://{$DOCUBITE_DOMAIN}{uri} permanent
}
