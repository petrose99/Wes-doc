      {
        "hooks": [
          {
            "type": "command",
            "command": "scripts/wayfinder-autopilot/hooks/context-guard.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "product@headcount": true,
    "marketing@headcount": true
  },
  "extraKnownMarketplaces": {
