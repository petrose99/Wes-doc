# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# data directory
/data/*

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist
/release

# misc
.DS_Store
*.pem
.vscode

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.production
.env.production.local
.env.whatsapp

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# databases
prisma/client
pgdata
*.db
*.sqlite
*.sqlite3
*.sqlite-journal
*.db-journal
# Sentry Config File
.env.sentry-build-plugin

# Local git worktrees
.worktrees/

.vercel
.impeccable/hook.cache.json
.env.production.bak.*

# autopilot session artefacts (local only)
.impeccable/live/
.impeccable/live
.scratch*/
docs/wayfinder-reports/*/logs/

# wayfinder driver state: the phase high-water mark per ticket
docs/wayfinder-reports/*/*.phase
# live driver feed: a git stash/checkout in a session replaces the inode and the
# detached driver keeps writing to the deleted one (2026-09-20, #330 session)
docs/wayfinder-reports/*/detached*.out
.preview/

# wayfinder autopilot: provider secrets
.claude/wayfinder-autopilot/mistral/.env
