# Copy to .env.production on the Lightsail instance and fill in real values.
# NEVER commit the filled-in .env.production file.

PORT=7331
DISABLE_SIGNUP=false
ENFORCE_PLAN_LIMITS=true

# --- Postgres (self-hosted pgvector, the `db` service) ---
POSTGRES_USER=docubite
POSTGRES_PASSWORD=
POSTGRES_DB=document_inbox
DATABASE_URL=postgresql://docubite:REPLACE_ME@db:5432/document_inbox

UPLOAD_PATH=./data/uploads

# --- LLM / extraction ---
AI_PROVIDER=gemini
GEMINI_MODEL_NAME=gemini-2.5-flash
GEMINI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_API_KEY=

MINERU_API_TOKEN=
MINERU_API_BASE=https://mineru.net
MINERU_MODEL_VERSION=vlm

# --- RAG embeddings (optional) ---
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_FORMAT=huggingface
EMBEDDINGS_MODEL_NAME=BAAI/bge-base-en-v1.5
EMBEDDINGS_DIMENSIONS=768

# --- Auth (Supabase) ---
# NEXT_PUBLIC_* values also go into docker-compose.prod.yml's `web.build.args` at build time.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUTH_HOOK_SECRET=
# Optional "Continue with Google" (Google Identity Services). Leave blank to omit the button.
# The matching client secret goes in the Supabase dashboard, never here.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Rolling inactivity logoff, refreshed on every request — 30 days (below) is a typical SaaS default.
# Set this to 15 instead if any workspace on THIS deployment has hipaaMode on: it is one process-wide
# value and cannot vary per workspace. See lib/config.ts and docs/security/HIPAA-TECHNICAL-SAFEGUARDS.md.
SESSION_IDLE_TIMEOUT_MINUTES=43200

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_GROWTH_PRICE_ID=

# --- Email ---
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
RESEND_FROM_EMAIL="DocuBite <user@localhost>"

# --- AWS (S3 document storage) ---
AWS_REGION=eu-west-2
AWS_S3_DOCUMENTS_BUCKET=
AWS_S3_KMS_KEY_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MALWARE_SCAN_URL=

INTERNAL_WORKER_SECRET=

# --- Outbound integrations ---
SECRETS_ENCRYPTION_KEY=
SECRETS_ENCRYPTION_KEY_PREVIOUS=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENVIRONMENT=production
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# --- Bigcapital ---
BIGCAPITAL_ENABLED=true
BIGCAPITAL_API_BASE=https://REPLACE_bigcapital_domain
BIGCAPITAL_WEBAPP_URL=https://REPLACE_bigcapital_domain
BIGCAPITAL_MYSQL_ROOT_PASSWORD=
BIGCAPITAL_MINIO_ROOT_PASSWORD=
BIGCAPITAL_AGENDASH_PASSWORD=

# --- Caddy (reverse proxy / TLS) ---
DOCUBITE_DOMAIN=REPLACE_docubite_domain
BIGCAPITAL_DOMAIN=REPLACE_bigcapital_domain
